; Engine configuration file.
; Edit through Project > Project Settings where possible.

config_version=5

[application]

config/name="My Caramelo"
config/description="Idle growth game shown as a transparent desktop overlay."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

; Design canvas is 1920x1080; 1366x768 and 1280x720-class windows scale down.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; The game runs as a transparent desktop overlay by default (see PlatformService).
window/size/borderless=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true

[autoload]

ContentCatalog="*res://scripts/autoload/content_catalog.gd"
PlatformService="*res://scripts/autoload/platform_service.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[physics]

; Nothing uses physics; tick it rarely to save power.
common/physics_ticks_per_second=10

[rendering]

viewport/transparent_background=true

; Compatibility renderer: widest desktop GPU support and lowest idle cost,
; which matters for an overlay left running all day.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
